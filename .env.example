# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=mongodb://localhost:27017/sports-facility-booking

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Default Admin Credentials (for seeding)
DEFAULT_ADMIN_PASSWORD=admin@123
